// AssetFinder admin data model.
// Learn more about Prisma: https://pris.ly/d/prisma-schema

generator client {
  provider = "prisma-client"
  output   = "../src/generated/prisma"
}

datasource db {
  provider  = "postgresql"
  url       = env("DATABASE_URL")
  directUrl = env("POSTGRES_URL_NON_POOLING")
}

enum AdminRole {
  SUPER_ADMIN
  ADMIN
  EDITOR
}

model AdminUser {
  id           String    @id @default(cuid())
  email        String    @unique
  passwordHash String
  name         String
  role         AdminRole @default(EDITOR)
  avatarUrl    String?
  title        String?
  phone        String?
  linkedinUrl  String?
  bio          String?
  cardSlug     String?   @unique
  lastLoginAt  DateTime?
  createdAt    DateTime  @default(now())
  updatedAt    DateTime  @updatedAt

  activityLogs ActivityLog[]

  @@map("admin_users")
}

model ActivityLog {
  id        String   @id @default(cuid())
  userId    String?
  user      AdminUser? @relation(fields: [userId], references: [id], onDelete: SetNull)
  action    String
  entity    String?
  entityId  String?
  detail    String?
  createdAt DateTime @default(now())

  @@index([userId])
  @@index([createdAt])
  @@map("activity_logs")
}

model Page {
  id          String   @id @default(cuid())
  slug        String   @unique
  title       String
  // Ordered array of section blocks: [{ type, id, fields: {...} }, ...]
  sections    Json     @default("[]")
  published   Boolean  @default(true)
  seo         Seo?
  updatedById String?
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  @@map("pages")
}

model Seo {
  id            String   @id @default(cuid())
  page          Page     @relation(fields: [pageId], references: [id], onDelete: Cascade)
  pageId        String   @unique

  // Classic SEO
  metaTitle       String?
  metaDescription String?
  keywords        String?
  canonicalUrl    String?
  ogImageUrl      String?
  noindex         Boolean  @default(false)

  // AEO (Answer Engine Optimization) — direct-answer content for
  // featured snippets / voice assistants.
  primaryQuestion String?
  directAnswer    String?
  faqJson         Json?    // [{ question, answer }, ...]

  // GEO (Generative Engine Optimization) — structured facts and
  // citation-friendly summary for LLM answer engines (ChatGPT, Perplexity,
  // Google AI Overviews).
  aiSummary       String?
  keyFacts        Json?    // [{ label, value }, ...]
  structuredData  Json?    // raw JSON-LD to inject

  updatedAt     DateTime @updatedAt

  @@map("seo")
}

enum MediaType {
  IMAGE
  VIDEO
  DOCUMENT
  OTHER
}

model MediaAsset {
  id           String    @id @default(cuid())
  url          String
  pathname     String
  filename     String
  type         MediaType @default(IMAGE)
  contentType  String?
  size         Int?
  width        Int?
  height       Int?
  alt          String?
  folder       String?
  uploadedById String?
  createdAt    DateTime  @default(now())

  @@index([folder])
  @@map("media_assets")
}

enum CrmStatus {
  LEAD
  QUALIFIED
  DEMO_BOOKED
  CUSTOMER
  CHURNED
  ARCHIVED
}

model CrmContact {
  id          String      @id @default(cuid())
  name        String
  company     String?
  email       String?
  phone       String?
  role        String?
  status      CrmStatus   @default(LEAD)
  source      String?
  notes       String?
  tags        String[]    @default([])
  portalSlug  String?     @unique
  createdAt   DateTime    @default(now())
  updatedAt   DateTime    @updatedAt

  activities  CrmActivity[]
  assets      Asset[]
  scanLogs    ScanLog[]

  @@index([status])
  @@map("crm_contacts")
}

enum ComplianceStatus {
  COMPLIANT
  DUE_SOON
  OVERDUE
  UNKNOWN
}

model Asset {
  id              String           @id @default(cuid())
  barcode         String           @unique
  name            String
  type            String
  location        String?
  status          ComplianceStatus @default(UNKNOWN)
  installedAt     DateTime?
  lastInspectedAt DateTime?
  nextDueAt       DateTime?
  notes           String?
  clientId        String
  client          CrmContact       @relation(fields: [clientId], references: [id], onDelete: Cascade)
  createdAt       DateTime         @default(now())
  updatedAt       DateTime         @updatedAt

  events          AssetEvent[]
  scanLogs        ScanLog[]

  @@index([clientId])
  @@map("assets")
}

model AssetEvent {
  id         String   @id @default(cuid())
  asset      Asset    @relation(fields: [assetId], references: [id], onDelete: Cascade)
  assetId    String
  type       String
  label      String
  occurredAt DateTime @default(now())

  @@index([assetId])
  @@map("asset_events")
}

model ScanLog {
  id         String     @id @default(cuid())
  client     CrmContact @relation(fields: [clientId], references: [id], onDelete: Cascade)
  clientId   String
  asset      Asset?     @relation(fields: [assetId], references: [id], onDelete: SetNull)
  assetId    String?
  barcode    String
  found      Boolean    @default(false)
  latitude   Float?
  longitude  Float?
  accuracy   Float?
  createdAt  DateTime   @default(now())

  @@index([clientId])
  @@index([assetId])
  @@map("scan_logs")
}

enum SubscriberStatus {
  SUBSCRIBED
  UNSUBSCRIBED
}

model Subscriber {
  id               String           @id @default(cuid())
  email            String           @unique
  name             String?
  status           SubscriberStatus @default(SUBSCRIBED)
  source           String?
  unsubscribeToken String           @unique @default(cuid())
  createdAt        DateTime         @default(now())
  updatedAt        DateTime         @updatedAt

  @@index([status])
  @@map("subscribers")
}

enum CampaignStatus {
  DRAFT
  SCHEDULED
  SENDING
  SENT
}

model Campaign {
  id             String         @id @default(cuid())
  name           String
  subject        String         @default("")
  previewText    String?
  fromName       String         @default("AssetFinder")
  fromEmail      String         @default("hello@assetfinder.au")
  blocks         Json           @default("[]")
  status         CampaignStatus @default(DRAFT)
  scheduledAt    DateTime?
  sentAt         DateTime?
  recipientCount Int?
  openCount      Int            @default(0)
  clickCount     Int            @default(0)
  createdById    String?
  createdAt      DateTime       @default(now())
  updatedAt      DateTime       @updatedAt

  @@index([status])
  @@map("campaigns")
}

model CrmActivity {
  id        String     @id @default(cuid())
  contact   CrmContact @relation(fields: [contactId], references: [id], onDelete: Cascade)
  contactId String
  type      String     // note, call, email, meeting, status_change
  content   String?
  createdAt DateTime   @default(now())

  @@index([contactId])
  @@map("crm_activities")
}

model FormSubmission {
  id        String   @id @default(cuid())
  formName  String   @default("contact")
  data      Json
  email     String?
  read      Boolean  @default(false)
  spam      Boolean  @default(false)
  createdAt DateTime @default(now())

  @@map("form_submissions")
}

model PageView {
  id        String   @id @default(cuid())
  path      String
  referrer  String?
  country   String?
  city      String?
  device    String?
  userAgent String?
  sessionId String?
  createdAt DateTime @default(now())

  @@index([path])
  @@index([createdAt])
  @@map("page_views")
}

model Setting {
  key       String   @id
  value     Json
  updatedAt DateTime @updatedAt

  @@map("settings")
}
